/* 全部徽章展开面板：与 badge-modal 同款毛玻璃遮罩 + 圆角卡片 */
.mask {
  position: fixed;
  inset: 0;
  z-index: 500;
  background: rgba(20, 20, 24, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel {
  width: 600rpx;
  max-height: 76vh;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  animation: panel-pop 0.22s ease-out;
}

@keyframes panel-pop {
  from {
    transform: scale(0.92);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.panel-head {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx 20rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2b2b2b;
}

.panel-cnt {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #9a9a9a;
}

.panel-close {
  margin-left: auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: #8a8a8a;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.panel-scroll {
  flex: 1;
  padding: 0 32rpx 30rpx;
  box-sizing: border-box;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx 20rpx;
}

.cell {
  width: calc((100% - 40rpx) / 3);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cell-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #4a4a4a;
}

.cell-name.locked {
  color: #b0b0b0;
}
