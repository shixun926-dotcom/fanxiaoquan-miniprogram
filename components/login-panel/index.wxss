/* 组件样式（app.wxss 不注入组件，样式在此补齐） */

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(36, 24, 18, 0.55);
  z-index: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-card {
  width: 620rpx;
  background: linear-gradient(180deg, #FFF6EC 0%, #ffffff 26%);
  border-radius: 36rpx;
  padding: 56rpx 48rpx 44rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 60rpx rgba(232, 67, 46, 0.22);
}

.login-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB88A, #FF6B35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  box-shadow: 0 12rpx 28rpx rgba(255, 107, 53, 0.3);
}

.login-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 28rpx;
}

.login-desc {
  font-size: 25rpx;
  color: #9C8B7C;
  line-height: 1.7;
  margin-top: 12rpx;
  text-align: center;
}

.login-btn {
  width: 100%;
  margin-top: 36rpx;
  background: linear-gradient(135deg, #FF6B35, #E8432E);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(232, 67, 46, 0.25);
}

.login-btn.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.login-skip {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #B3A292;
  padding: 8rpx 24rpx;
}

/* ---------- 头像按钮（open-type="chooseAvatar"） ---------- */

.avatar-btn {
  margin-top: 32rpx;
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  border-radius: 50%;
  background: #F6EFE6;
  border: none;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-btn::after {
  border: none;
}

.avatar-preview {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 72rpx;
  line-height: 1;
}

.avatar-tip {
  font-size: 22rpx;
  color: #B3A292;
  margin-top: 12rpx;
}

/* ---------- 昵称输入 ---------- */

.nick-input {
  width: 100%;
  margin-top: 28rpx;
  background: #F6EFE6;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.ph {
  color: #C9B8A8;
}
