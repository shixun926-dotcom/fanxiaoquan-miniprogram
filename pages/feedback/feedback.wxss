/* pages/feedback —— 意见反馈（烟火实验室 · Warm Kitchen Lab 设计令牌） */

.f-card {
  padding: 28rpx 32rpx;
}

.f-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B5A4C;
  margin-bottom: 20rpx;
}

/* 内容区 */
.f-textarea {
  width: 100%;
  min-height: 240rpx;
  background: #FBF6EF;
  border: 1rpx solid #F0E0CE;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.f-count {
  text-align: right;
  font-size: 22rpx;
  color: #B3A292;
  margin-top: 8rpx;
}

/* 附图网格 */
.f-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.f-img {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.f-img image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  border: 1rpx solid #F3E3D3;
  background: #F6EFE6;
}

.f-img-del {
  position: absolute;
  top: -14rpx;
  right: -14rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(36, 24, 18, 0.75);
  color: #fff;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.f-img-add {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #DCC9B4;
  background: #FBF6EF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #C9B8A8;
}

/* 联系方式 */
.f-input {
  margin-top: 20rpx;
  background: #FBF6EF;
  border: 1rpx solid #F0E0CE;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.f-sub-tip {
  font-size: 22rpx;
  color: #B3A292;
  margin-top: 12rpx;
}

/* 提交按钮（渐变主色，loading 置灰） */
.f-submit {
  margin: 40rpx 24rpx 60rpx;
  padding: 26rpx 0;
  border-radius: 999rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #FF6B35, #E8432E);
  box-shadow: 0 10rpx 24rpx rgba(232, 67, 46, 0.35);
}

.f-submit.disabled {
  opacity: 0.5;
  box-shadow: none;
}
