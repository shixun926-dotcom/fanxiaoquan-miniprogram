/* pages/feedback-detail —— 反馈详情（烟火实验室 · Warm Kitchen Lab 设计令牌） */

.f-d-head {
  padding: 28rpx 32rpx;
}

/* 与列表页同款标签/徽章样式（独立文件，需与 feedback-list.wxss 保持一致） */
.f-item-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.f-item-type {
  font-size: 22rpx;
  font-weight: 600;
  color: #E8432E;
  background: #FFF1E6;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.f-status {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.f-status.pending {
  background: #F1EFEC;
  color: #A8A19A;
}

.f-status.processing {
  background: #FFF3DF;
  color: #FFB020;
}

.f-status.resolved {
  background: #EAF6EC;
  color: #73B84B;
}

.f-d-content {
  font-size: 30rpx;
  color: #241812;
  line-height: 1.7;
  word-break: break-all;
}

/* 附图缩略图，点击大图预览 */
.f-d-images {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}

.f-d-images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 1rpx solid #F3E3D3;
  background: #F6EFE6;
}

.f-d-meta {
  font-size: 22rpx;
  color: #B3A292;
  margin-top: 24rpx;
}

/* 状态时间线 */
.f-timeline {
  padding: 28rpx 32rpx;
}

.f-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B5A4C;
  margin-bottom: 24rpx;
}

.f-tl-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  position: relative;
  padding-bottom: 32rpx;
}

.f-tl-row:last-child {
  padding-bottom: 0;
}

/* 竖线连接（最后一节不画） */
.f-tl-row:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: #F0E0CE;
}

.f-tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #DCC9B4;
  border: 4rpx solid #FBF6EF;
  box-shadow: 0 0 0 2rpx #DCC9B4;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.f-tl-dot.on {
  background: #E8432E;
  box-shadow: 0 0 0 2rpx #E8432E;
}

.f-tl-status {
  font-size: 28rpx;
  font-weight: 600;
  color: #9C8B7C;
}

.f-tl-status.on {
  color: #E8432E;
}

.f-tl-time {
  font-size: 22rpx;
  color: #B3A292;
  margin-top: 4rpx;
}

/* 客服回复气泡 */
.f-reply {
  padding: 28rpx 32rpx;
}

.f-reply-bubble {
  background: #FFF1E6;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #241812;
}

.f-d-tip {
  text-align: center;
  font-size: 24rpx;
  color: #B3A292;
  padding: 24rpx 0 48rpx;
}
