/* pages/reward —— 打赏开发者（UI/打赏功能设计文档.md F3，温情非商业化基调）
 * V0.2：微信赞赏码置顶、领取按钮升级为「徽章 + 渐变胶囊」、成功弹层加徽章大图 */

.page {
  padding-top: 40rpx;
}

/* ---------- 徽章 + 标语 ---------- */

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 44rpx;
}

/* 徽章柔光 + 上浮循环动画（蒸汽语言同源） */
.badge-wrap {
  position: relative;
  width: 216rpx;
  height: 216rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: float 3.2s ease-in-out infinite;
}

.badge-glow {
  position: absolute;
  inset: 6rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 200, 87, 0.45) 0%, rgba(255, 138, 31, 0.18) 55%, transparent 75%);
  filter: blur(6rpx);
}

.badge-img {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  z-index: 1;
}

/* 徽章上方两缕蒸汽（沿用全 App 蒸汽语言） */
.steam {
  position: absolute;
  width: 24rpx;
  height: 48rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
  z-index: 2;
  pointer-events: none;
  animation: steam-rise 2.4s ease-out infinite;
}

.steam.s1 { left: 78rpx; top: -6rpx; animation-delay: 0s; }
.steam.s2 { left: 116rpx; top: -14rpx; animation-delay: 0.8s; }
.steam.s3 { left: 148rpx; top: -4rpx; animation-delay: 1.6s; }

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.slogan {
  font-size: 38rpx;
  font-weight: 800;
  color: #E96B0C;
  margin-top: 26rpx;
  letter-spacing: 2rpx;
}

.sub-slogan {
  font-size: 24rpx;
  color: #9C8B7C;
  margin-top: 16rpx;
  text-align: center;
  line-height: 1.7;
  background: #FFF7EC;
  border: 1rpx dashed #FFDDB8;
  border-radius: 20rpx;
  padding: 14rpx 32rpx;
  max-width: 560rpx;
}

/* ---------- 二维码卡片 ---------- */

.qr-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #241812;
  margin-bottom: 22rpx;
}

.qr-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

/* 长按识别提示章（微信赞赏码卡片） */
.qr-tag {
  margin-left: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #E96B0C;
  background: #FFF1E6;
  border: 1rpx solid #FFD9C4;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 二维码白框（突出"原封不动"的素材） */
.qr-frame {
  width: 100%;
  background: #FFFFFF;
  border: 1rpx solid #F3E3D3;
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 6rpx 16rpx rgba(232, 67, 46, 0.08);
}

.qr-img {
  width: 100%;
  border-radius: 12rpx;
  display: block;
}

/* 爱发电占位（主页未配置，不显示死链） */
.qr-box {
  width: 100%;
  border-radius: 20rpx;
}

.qr-box.placeholder {
  height: 320rpx;
  border: 2rpx dashed #F3D8C2;
  background: #FFF9F0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ph-emoji {
  font-size: 64rpx;
}

.ph-text {
  font-size: 24rpx;
  color: #C9B8A8;
  margin-top: 12rpx;
}

.qr-note {
  font-size: 22rpx;
  color: #9C8B7C;
  margin-top: 20rpx;
}

/* ---------- 领取区 ---------- */

.claim-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 52rpx 24rpx 0;
}

/* 领取按钮：徽章白盘 + 渐变胶囊（UI/reward/preview.html reward-btn 同款） */
.claim-btn {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #FF8A1F, #E96B0C);
  border-radius: 999rpx;
  padding: 14rpx 56rpx 14rpx 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(233, 107, 12, 0.35);
}

.claim-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.claim-chip {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFFDF8;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.18);
  flex-shrink: 0;
}

.claim-txt {
  color: #FFFDF8;
  font-size: 28rpx;
  font-weight: 700;
}

.claim-sub {
  font-size: 24rpx;
  color: #9C8B7C;
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.6;
}

/* ---------- 领取成功弹层 ---------- */

.mask {
  position: fixed;
  inset: 0;
  background: rgba(36, 24, 18, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.code-modal {
  width: 580rpx;
  background: linear-gradient(180deg, #FFF6EC 0%, #FFFDF8 30%);
  border-radius: 40rpx;
  padding: 56rpx 40rpx 40rpx;
  box-shadow: 0 24rpx 60rpx rgba(36, 24, 18, 0.28);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 弹层顶部徽章大图（柔光 + 回弹入场） */
.modal-medal {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -12rpx;
  animation: pop-in 0.5s 0.1s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.modal-glow {
  position: absolute;
  inset: 4rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 200, 87, 0.5) 0%, rgba(255, 138, 31, 0.2) 55%, transparent 78%);
  filter: blur(6rpx);
}

.modal-img {
  width: 180rpx;
  height: 180rpx;
  position: relative;
  z-index: 1;
}

.code-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #241812;
  margin-top: 22rpx;
}

.code-desc {
  font-size: 26rpx;
  color: #5A4A3A;
  margin-top: 18rpx;
  text-align: center;
  line-height: 1.6;
}

/* 兑换码（点击即复制） */
.code-value {
  margin-top: 24rpx;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
  color: #E96B0C;
  background: #FFF1E6;
  border: 1rpx solid #FFD9C4;
  border-radius: 16rpx;
  padding: 16rpx 44rpx;
  box-shadow: inset 0 2rpx 6rpx rgba(233, 107, 12, 0.1);
}

.code-value:active {
  opacity: 0.75;
}

.code-tip {
  font-size: 22rpx;
  color: #9C8B7C;
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.7;
}

.code-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
  width: 100%;
}

.code-btn {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  padding: 20rpx 0;
  border-radius: 999rpx;
}

.code-btn.ghost {
  background: #FFF1E6;
  color: #E96B0C;
  border: 1rpx solid #FFD9C4;
}

.code-btn.primary {
  background: linear-gradient(135deg, #FF8A1F, #E96B0C);
  color: #FFFDF8;
  box-shadow: 0 8rpx 20rpx rgba(233, 107, 12, 0.3);
}
