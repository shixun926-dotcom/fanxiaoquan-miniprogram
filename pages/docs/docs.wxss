/* pages/docs —— 项目经理视角 */

.hero {
  background: linear-gradient(135deg, #FFB88A, #FF6B35);
  border-radius: 32rpx;
  margin: 24rpx 24rpx 24rpx;
  padding: 48rpx 40rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

/* ---------- 01 概览 ---------- */

.kv {
  margin-bottom: 24rpx;
}

.kv:last-child {
  margin-bottom: 0;
}

.kv-label {
  font-size: 24rpx;
  color: #FF6B35;
  font-weight: 600;
}

.kv-value {
  font-size: 27rpx;
  color: #3D4350;
  margin-top: 6rpx;
  line-height: 1.7;
}

/* ---------- 02 信息架构树 ---------- */

.tree-row {
  display: flex;
  align-items: baseline;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  border-left: 2rpx solid #F0E4DB;
  margin-left: 8rpx;
  flex-wrap: wrap;
}

.tree-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFB88A;
  margin-right: 16rpx;
  position: relative;
  left: -7rpx;
  flex-shrink: 0;
  align-self: center;
}

.tree-name {
  font-size: 27rpx;
  color: #3D4350;
}

.tree-name.root {
  font-size: 30rpx;
  font-weight: 700;
  color: #241812;
}

.tree-meta {
  width: 100%;
  font-size: 22rpx;
  color: #B3A292;
  margin-top: 4rpx;
  padding-left: 28rpx;
}

/* ---------- 03 外卖联动 ---------- */

.level {
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.level:last-child {
  margin-bottom: 0;
}

.level-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-key {
  background: #FF6B35;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 10rpx;
  padding: 4rpx 14rpx;
}

.level-title {
  font-size: 29rpx;
  font-weight: 700;
  flex: 1;
}

.level-status {
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.level-status.done {
  background: #E4F5E1;
  color: #2E9E44;
}

.level-status.todo {
  background: #E8F0FE;
  color: #3D6FD6;
}

.level-status.biz {
  background: #FFF3D8;
  color: #B97A00;
}

.level-desc {
  font-size: 25rpx;
  color: #6B5A4C;
  line-height: 1.7;
  margin-top: 14rpx;
}

.level-detail {
  font-size: 23rpx;
  color: #9C8B7C;
  margin-top: 8rpx;
}

/* ---------- 04 检查清单 ---------- */

.check {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.check:last-child {
  margin-bottom: 0;
}

.check-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFF1EA;
  color: #FF6B35;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.check-text {
  font-size: 26rpx;
  color: #3D4350;
  line-height: 1.7;
  flex: 1;
}

.foot-note {
  text-align: center;
  color: #C9B8A8;
  font-size: 22rpx;
  padding: 8rpx 0 48rpx;
}
